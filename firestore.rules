rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/tasks/{taskId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidTask() {
        return request.resource.data.keys().hasOnly([
          'title', 'description', 'priority', 'dueDate', 'completed',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.priority in ['low', 'medium', 'high']
        && (request.resource.data.dueDate == null
          || request.resource.data.dueDate is timestamp)
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isOwner();
      allow create: if isOwner() && hasValidTask();
      allow update: if isOwner()
        && hasValidTask()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }
  }
}
